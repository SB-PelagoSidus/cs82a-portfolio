        "# Module 9 Lab 1: Textbook Problem 6.1\n",
        "\n",
        "**Pounds to Kilograms Conversion**\n"
      ],
      "metadata": {
        "id": "nwuFaUJHH5-M"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def lbs_to_kg(pounds):\n",
        "    kilograms = pounds * 0.453592\n",
        "    return kilograms\n",
        "\n",
        "print(\"10 lbs =\", lbs_to_kg(10), \"kg\")\n",
        "print(\"100 lbs =\", lbs_to_kg(100), \"kg\")\n",
        "print(\"144 lbs =\", lbs_to_kg(144), \"kg\")"
      ],
      "metadata": {
